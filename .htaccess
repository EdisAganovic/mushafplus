# Mushaf Plus - Server Caching Configuration with Gzip
# Best used with Apache servers

<IfModule mod_expires.c>
    ExpiresActive On

    # HTML - Don't cache often to ensure UI updates are seen
    ExpiresByType text/html "access plus 0 seconds"

    # CSS and JavaScript - Stable files (1 Year)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Fonts - Very stable (1 Year)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # Media / Audio - Large assets (1 Month)
    ExpiresByType audio/mpeg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"

    # Quran data file - Very stable (1 Year)
    ExpiresByType application/json "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Enable gzip compression
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css application/json 
                              application/javascript application/x-javascript text/xml 
                              application/xml+rss application/ld+json
    </IfModule>

    # Ensure browsers verify files that are prone to change
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Force caching for static assets (1 Year)
    <FilesMatch "\.(css|js|woff2|woff|webp|png|jpg|jpeg|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Quran data file - Aggressive caching (1 Year) with versioning
    <FilesMatch "/data/quran_data\.js$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Expires "+1 year"
    </FilesMatch>
</IfModule>
